{
  "name": "incident-coordination-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "postinstall": "node scripts/patch-argparse.cjs && node scripts/patch-ui-utils.cjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "api": "node dist/src/api.js",
    "agent": "node dist/src/api.js"
  },
  "dependencies": {
    "@ag-ui/encoder": "1.0.2",
    "@ag-ui/mastra": "2.0.1",
    "@ai-sdk/anthropic": "3.0.103",
    "@ai-sdk/provider": "3.0.14",
    "@mastra/client-js": "1.54.0",
    "@mastra/core": "1.77.0",
    "@mastra/express": "1.5.21",
    "express": "5.3.0",
    "secure-json-parse": "4.1.1",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "gray-matter@4": {
      "js-yaml@3": {
        "argparse": "2.0.1"
      }
    },
    "@ai-sdk/ui-utils@1.2.11": {
      "@ai-sdk/provider-utils": "3.0.30"
    }
  }
}
