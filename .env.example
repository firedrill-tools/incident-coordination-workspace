NEXT_PUBLIC_INCIDENT_API_URL=http://localhost:8126
INCIDENT_AGENT_URL=http://127.0.0.1:8126/agent
INCIDENT_WEB_ORIGIN=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1
COPILOTKIT_TELEMETRY_DISABLED=true
OTEL_SDK_DISABLED=true
